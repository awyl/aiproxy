# aiproxy example configuration.
#
# Upstream keys live in env vars ONLY, referenced by `api_key_env` name.
# Agent-facing model ids are always `{upstream name}/{model id}`, e.g.
# `opencode-go/kimi-k3`.

bind: 127.0.0.1:8080          # listen "host:port"; 0.0.0.0:8080 = all interfaces
                               # (reverse proxy recommended for anything public)
token_env: AIPROXY_TOKEN           # or token: "literal". Omit both = auth disabled.
model_refresh_secs: 0              # discovery interval; 0 = fetch once at startup (default)
thinking: high                     # pi extension: default thinking level for all models
                                   # (off|low|medium|high|max); ignored by the proxy itself

# Multi-subscription: give each upstream its own bearer token. The token both
# authenticates the request AND locks it to that subscription's models; requests
# for a prefix you don't own are rejected (401). Owner token example:
#
# upstreams:
#   - name: go-alice
#     kind: opencode-go
#     api_key_env: GO_ALICE_KEY
#     token_env: GO_ALICE_TOKEN      # env holding alice's proxy token
#     discover: true
#   - name: go-bob
#     kind: opencode-go
#     api_key_env: GO_BOB_KEY
#     token_env: GO_BOB_TOKEN
#     discover: true
#
# Model ids become go-alice/mimo-v2.5 and go-bob/mimo-v2.5.

  # MiniMax (international) — OpenAI-compatible wire (api.minimax.io/v1).
  # Token Plan (Subscription Key, sk-cp-...) and pay-as-you-go API keys both
  # go in the same env var; the proxy relays your Bearer as-is.
  - name: minimax
    kind: minimax
    api_key_env: MINIMAX_API_KEY
    models: [MiniMax-M3, MiniMax-M2.7, MiniMax-M2.7-highspeed]   # streams; surface = chat
    # discover: true   # instead, probe GET /v1/models at startup (needs the key)

  # OpenRouter — OpenAI-compatible aggregator (openrouter.ai/api/v1).
  # Model ids are `provider/model`; the catalog is PUBLIC/keyless, only chat
  # calls need OPENROUTER_API_KEY.
  - name: openrouter
    kind: openrouter
    api_key_env: OPENROUTER_API_KEY
    discover: true          # safe: GET /v1/models is keyless (396 models)

  # Z.AI GLM Coding Plan — OpenAI-compatible wire (api.z.ai/api/coding/paas/v4).
  # The coding-plan API key (individual or team) goes in ZAI_API_KEY.
  - name: zai
    kind: zai
    api_key_env: ZAI_API_KEY
    models: [glm-5.3, glm-5.3-flash]                            # streams; surface = chat
    # discover: true   # instead, probe GET /v1/models at startup (needs the key)

upstreams:
  # OpenCode Go — flagship upstream. Discovery is opt-in like any other:
  # ids from https://opencode.ai/zen/go/v1/models (public, keyless — that's
  # why this is safe to enable), surfaces parsed from surface_map_url on the
  # same refresh cadence as the ids (startup + model_refresh_secs; no TTL),
  # builtin snapshot fallback.
  - name: opencode-go
    kind: opencode-go
    api_key_env: OPENCODE_GO_API_KEY
    discover: true
    # endpoint_by_model:            # overrides for new models (chat | messages | responses)
    #   qwen3.9-x: messages
    # surface_map_url: https://opencode.ai/docs/go   # runtime surface source (default)

  # Every upstream is catalog-only unless you opt in:
  #   - `models: [...]`   -> static list, never probed (recommended)
  #   - `discover: true`  -> probe GET <base_url>/models at startup/refresh.
  #                          Requires the upstream to be reachable AND keyed;
  #                          otherwise expect per-refresh warnings (401 etc).
  # Omitting both declarations a provider with an EMPTY catalog: requests
  # still route to it, but agents won't see models in /v1/models.

  # OpenAI-compatible gateway with a pinned model list (no probing):
  - name: openai
    kind: openai
    api_key_env: OPENAI_API_KEY
    models: [gpt-4o, gpt-4o-mini]

  # Anthropic-compatible gateway, discovery enabled:
  - name: anthropic
    kind: anthropic
    api_key_env: ANTHROPIC_API_KEY
    discover: true

  # Keyless local server (e.g. Ollama) speaking the OpenAI surface:
  - name: local
    kind: openai
    base_url: http://localhost:11434/v1
    discover: true

mcp:
  servers:
    # stdio backend: proxy spawns the child and re-exposes it at /mcp/filesystem
    - name: filesystem
      command: npx
      args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]

    # remote streamable-HTTP backend
    - name: github
      url: https://api.githubcopilot.com/mcp/
      api_key_env: GITHUB_TOKEN